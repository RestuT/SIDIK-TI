# SIDIK-TI Git Attributes
# Mencegah Git mengubah encoding atau menambahkan BOM pada file PHP

# Paksa semua PHP file menggunakan LF line endings dan tidak punya BOM
*.php   text eol=lf working-tree-encoding=UTF-8
*.json  text eol=lf
*.ini   text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.env   text eol=lf

# File binary - jangan dimodifikasi
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
